<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground glass overlay for full-bleed 16:9 app artwork tiles -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Soft top-left glass specular sheen across focused artwork -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="#20FFFFFF"
                        android:centerColor="#04FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <!-- Crisp 1.5dp luminous white focus ring inset cleanly inside 13dp clip -->
            <item android:left="0.75dp" android:top="0.75dp" android:right="0.75dp" android:bottom="0.75dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="1.5dp" android:color="#F6FFFFFF" />
                    <corners android:radius="12.25dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Whisper-subtle bottom cinema vignette so tiles settle into obsidian -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#24040508"
                        android:centerColor="#05040508"
                        android:endColor="#00000000" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <!-- Hairline inner glass edge so dark-background banners stay defined on obsidian -->
            <item android:left="0.5dp" android:top="0.5dp" android:right="0.5dp" android:bottom="0.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="1dp" android:color="#1EFFFFFF" />
                    <corners android:radius="12.5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
