<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone circular frosted obsidian glass button (12-o'clock overhead lit) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#EBFFFFFF"
                        android:centerColor="#88CBD5E1"
                        android:endColor="#5594A3B8" />
                </shape>
            </item>
            <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#F0262E3E"
                        android:endColor="#F0151923" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#34FFFFFF"
                        android:centerColor="#12FFFFFF"
                        android:endColor="#08FFFFFF" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#E0141822"
                        android:endColor="#E00B0E14" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
