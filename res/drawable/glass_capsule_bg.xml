<?xml version="1.0" encoding="utf-8"?>
<!-- Unified frosted obsidian capsule with top-lit specular glass rim (zero blur cost) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#36FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#08FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#E0141822"
                android:endColor="#E00B0E14" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
