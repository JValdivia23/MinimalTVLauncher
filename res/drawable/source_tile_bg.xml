<?xml version="1.0" encoding="utf-8"?>
<!-- Smoked obsidian glass body for primary hardware sources (3D rim drawn by BevelRimDrawable) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#F0202634"
                        android:endColor="#F012151E" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Symmetric 12-o'clock overhead glass sheen -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#16FFFFFF"
                        android:centerColor="#03FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#D4141822"
                android:endColor="#D40C0F16" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
