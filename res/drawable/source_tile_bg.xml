<?xml version="1.0" encoding="utf-8"?>
<!-- Specular obsidian glass tile for hardware sources (DP / USB-C / HDMI / All Inputs) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Crisp top-lit luminous white glass rim -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#F8FFFFFF"
                        android:centerColor="#CCFFFFFF"
                        android:endColor="#88FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Elevated smoked glass body -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#EB232936"
                        android:endColor="#EB151821" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Subtle top-left specular sheen -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="#1EFFFFFF"
                        android:centerColor="#05FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Whisper-quiet top-lit hairline glass edge -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#2AFFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#08FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Translucent obsidian body allowing ambient backlight bleed -->
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#CC141720"
                        android:endColor="#CC0E1117" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
