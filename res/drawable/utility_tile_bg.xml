<?xml version="1.0" encoding="utf-8"?>
<!-- Recessed ghost-glass tile for secondary OSD overflow ("All Inputs") -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="315"
                        android:startColor="#FAFFFFFF"
                        android:centerColor="#8CFFFFFF"
                        android:endColor="#32FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#F01E2432"
                        android:endColor="#F011141D" />
                    <corners android:radius="14.5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#18FFFFFF"
                        android:centerColor="#08FFFFFF"
                        android:endColor="#04FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#940E1118"
                        android:endColor="#94090B10" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
